#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
python3 - <<'PY'
import hashlib,json,pathlib,subprocess
for project, source in json.load(open('sources.json')).items():
    root=pathlib.Path('..',project)
    for path,blob in source['blobs'].items():
        content=(root/path).read_bytes()
        pinned=subprocess.check_output(['git','-C',root,'rev-parse',source['revision']+':'+path],text=True).strip()
        actual=hashlib.sha1(b'blob '+str(len(content)).encode()+b'\0'+content).hexdigest()
        if pinned!=blob or actual!=source.get('observedWorktreeBlobs',{}).get(path,blob):
            raise SystemExit(f'{project}/{path}: source changed; review the affected model')
    print(f"{project}: verified {len(source['blobs'])} source blobs")
PY
mkdir -p .build
node moment/GraphProbe.mjs
"${CXX:-c++}" -std=c++23 -I../playground/include playground/LedgerProbe.cpp -o .build/ledger
.build/ledger
(cd ../re-desktop; node scripts/bend.mjs PROOF.bend --verdict)
