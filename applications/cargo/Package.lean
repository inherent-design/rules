namespace ApplicationStudy.CargoPackage

/-- Matched facts for this private Git fixture. Pattern matching, Git discovery,
    symlinks, and arbitrary metadata paths are not implemented by this model. -/
structure FileFacts where
  prohibited : Bool
  required : Bool
  gitIgnored : Bool
  includeMatch : Bool
  excludeMatch : Bool
  deriving Repr

def selected (explicitInclude : Bool) (file : FileFacts) : Bool :=
  !file.prohibited && (file.required ||
    if explicitInclude then file.includeMatch else !file.gitIgnored && !file.excludeMatch)

inductive Profile | defaults | exclude | include | both deriving BEq, DecidableEq, Repr

def explicitInclude (profile : Profile) : Bool := profile == .include || profile == .both

/-- Only named files generated by the collector; no arbitrary glob decoder. -/
def files : List String := [".cargo_vcs_info.json", ".gitignore", "Cargo.lock", "Cargo.toml",
  "Cargo.toml.orig", "LICENSE.txt", "README.md", "data/drop.txt", "data/keep.txt", "ignored.txt", "src/lib.rs"]

def member (profile : Profile) (includeLock : Bool) (name : String) : Bool :=
  if name == "Cargo.lock" then includeLock
  else if [".cargo_vcs_info.json", "Cargo.toml.orig"].contains name then true
  else selected (explicitInclude profile) ⟨
    ["target/never.txt", "nested/Cargo.toml", "nested/src/lib.rs"].contains name,
    ["Cargo.toml", "LICENSE.txt", "README.md"].contains name,
    name == "ignored.txt",
    ["src/lib.rs", "data/keep.txt", "ignored.txt"].contains name,
    (profile == .exclude && name == "data/drop.txt") || (profile == .both && name == "data/keep.txt")⟩

def inventory (profile : Profile) (includeLock : Bool) : List String :=
  files.filter (member profile includeLock)

inductive Request | list | unchecked | verify deriving BEq, DecidableEq, Repr

structure Outcome where
  archiveCreated : Bool
  buildChecked : Bool
  buildSucceeded : Bool
  commandSucceeded : Bool
  deriving BEq, DecidableEq, Repr

/-- A fresh owned destination and completed archive creation are premises.
    Only the controlled compile error varies; IO failures and existing outputs
    require additional states. This is not a general packaging transaction. -/
def outcome (request : Request) (compiles : Bool) : Outcome :=
  match request with
  | .list => ⟨false, false, false, true⟩
  | .unchecked => ⟨true, false, false, true⟩
  | .verify => ⟨true, true, compiles, compiles⟩

theorem prohibited_input_not_selected (useInclude : Bool) (file : FileFacts) (h : file.prohibited = true) :
    selected useInclude file = false := by simp [selected, h]

theorem required_root_metadata_survives_filter (useInclude : Bool) (file : FileFacts)
    (h₁ : file.prohibited = false) (h₂ : file.required = true) : selected useInclude file = true := by
  simp [selected, h₁, h₂]

theorem include_ignores_git_and_exclude (file : FileFacts) (h₁ : file.prohibited = false)
    (h₂ : file.required = false) : selected true file = file.includeMatch := by simp [selected, h₁, h₂]

theorem both_uses_include_selection (lock : Bool) : inventory .both lock = inventory .include lock := by
  cases lock <;> decide

theorem explicit_include_can_select_gitignored : member .include true "ignored.txt" = true ∧
    member .defaults true "ignored.txt" = false := ⟨rfl, rfl⟩

theorem listing_does_not_create_archive (compiles : Bool) : (outcome .list compiles).archiveCreated = false := rfl

theorem unchecked_archive_is_not_build_evidence (compiles : Bool) :
    (outcome .unchecked compiles).archiveCreated = true ∧ (outcome .unchecked compiles).buildChecked = false := ⟨rfl, rfl⟩

theorem failed_verification_can_leave_archive :
    (outcome .verify false).archiveCreated = true ∧ (outcome .verify false).commandSucceeded = false := ⟨rfl, rfl⟩

theorem archive_presence_cannot_identify_success :
    (outcome .verify false).archiveCreated = (outcome .verify true).archiveCreated ∧
    (outcome .verify false).commandSucceeded ≠ (outcome .verify true).commandSucceeded := by decide

end ApplicationStudy.CargoPackage
