{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "never"
  },
  "includes": [
    "*.md",
    "docs/**/*.md",
    ".github/**/*.md"
  ],
  "excludes": [
    ".build/**",
    ".tools/**",
    "node_modules/**",
    "common/**",
    "empack/**",
    "host/**",
    "moment/**",
    "playground/**",
    "profiles/**",
    "re-desktop/**",
    "simulacrum/**",
    "terminal/**",
    "applications/**",
    "review.md",
    "**/sources/**",
    "**/evidence/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
